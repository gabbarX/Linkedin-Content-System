generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id                  String   @id @db.Uuid
  email               String
  full_name           String?
  timezone            String   @default("UTC")
  cadence_per_week    Int      @default(3) @db.SmallInt
  preferred_post_time DateTime @default(dbgenerated("'08:00:00'::time without time zone")) @db.Time(6)
  onboarding_step     String   @default("interview")
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  interview_draft     Json?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model business_profiles {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @unique @db.Uuid
  offer          String
  price_band     String?
  icp            String
  transformation String
  proof          String?
  point_of_view  String?
  taboos         String[] @default([])
  cta_target     String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model voice_profiles {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @unique @db.Uuid
  avg_sentence_length Decimal?  @db.Decimal(5, 2)
  max_sentence_length Int?
  avg_paragraph_lines Decimal?  @db.Decimal(5, 2)
  sentence_rhythm     String    @default("varied")
  line_break_style    String    @default("grouped")
  emoji_policy        String    @default("none")
  hashtag_policy      String    @default("none")
  pov_strength        String    @default("balanced")
  humour_level        String    @default("none")
  formality           String    @default("conversational")
  opener_patterns     String[]  @default([])
  closer_patterns     String[]  @default([])
  vocabulary_markers  String[]  @default([])
  banned_phrases      String[]  @default([])
  derived_at          DateTime? @db.Timestamptz(6)
  user_edited         Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model writing_samples {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  content       String
  source        String   @default("pasted")
  word_count    Int      @default(0)
  char_count    Int      @default(0)
  line_count    Int      @default(0)
  emoji_count   Int      @default(0)
  hashtag_count Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pillars {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategy_id String     @db.Uuid
  user_id     String     @db.Uuid
  position    Int        @db.SmallInt
  name        String
  description String
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  strategies  strategies @relation(fields: [strategy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  slots       slots[]

  @@unique([strategy_id, position])
  @@index([strategy_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model slots {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  strategy_id  String     @db.Uuid
  user_id      String     @db.Uuid
  pillar_id    String     @db.Uuid
  week_index   Int        @db.SmallInt
  position     Int        @db.SmallInt
  scheduled_on DateTime   @db.Date
  theme        String
  angle        String
  format       String
  brief        String
  hook         String?
  key_points   String[]   @default([])
  proof_point  String?
  cta          String?
  status       String     @default("planned")
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  posts        posts?
  pillars      pillars    @relation(fields: [pillar_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  strategies   strategies @relation(fields: [strategy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([strategy_id, scheduled_on])
  @@unique([strategy_id, week_index, position])
  @@index([pillar_id])
  @@index([strategy_id])
  @@index([user_id, scheduled_on])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model strategies {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @unique @db.Uuid
  version             Int       @default(1)
  cadence_per_week    Int       @db.SmallInt
  starts_on           DateTime  @db.Date
  positioning         String
  phase_authority     String
  phase_problem_aware String
  phase_offer_aware   String
  phase_invitation    String
  week_themes         String[]
  generated_at        DateTime  @default(now()) @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  pillars             pillars[]
  slots               slots[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @unique @db.Uuid
  razorpay_subscription_id String    @unique
  razorpay_plan_id         String
  razorpay_customer_id     String?
  status                   String
  current_start            DateTime? @db.Timestamptz(6)
  current_end              DateTime? @db.Timestamptz(6)
  charge_at                DateTime? @db.Timestamptz(6)
  cancel_at_cycle_end      Boolean   @default(false)
  ended_at                 DateTime? @db.Timestamptz(6)
  last_event_at            DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model post_variants {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  post_id       String   @db.Uuid
  variant_index Int      @db.SmallInt
  approach      String
  content       String
  char_count    Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  posts         posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post_id, approach])
  @@unique([post_id, variant_index])
  @@index([post_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model posts {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String          @db.Uuid
  slot_id                String?         @unique(where: raw("(slot_id IS NOT NULL)")) @db.Uuid
  slot_theme             String
  slot_format            String
  slot_scheduled_on      DateTime?       @db.Date
  brief_angle            String
  brief_hook             String
  brief_key_points       String[]        @default([])
  brief_proof            String?
  brief_cta              String
  variant_index          Int?            @db.SmallInt
  final_text             String?
  polished_text          String?
  status                 String          @default("draft")
  approved_at            DateTime?       @db.Timestamptz(6)
  borrowed_from_variants Int[]           @default([]) @db.SmallInt
  borrowed_char_count    Int             @default(0)
  edit_ratio             Decimal?        @db.Decimal(4, 3)
  polish_outcome         String?
  linkedin_urn           String?
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime        @default(now()) @db.Timestamptz(6)
  post_variants          post_variants[]
  slots                  slots?          @relation(fields: [slot_id], references: [id], onUpdate: NoAction)

  @@index([user_id])
  @@index([user_id, slot_scheduled_on], map: "posts_user_scheduled_idx")
}
